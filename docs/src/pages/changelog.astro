---
import { createMarkdownProcessor } from '@astrojs/markdown-remark'
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

import changelog from '../../../CHANGELOG.md?raw'
import { markdownOptions } from '../utils/markdown-config.ts'

// Render text only: Astro must never compile delegated changelog frontmatter as a module.
const processor = await createMarkdownProcessor(markdownOptions)
const { code, metadata: { headings } } = await processor.render(changelog)
---

<StarlightPage frontmatter={{ title: 'Changelog' }} headings={headings}>
	<div class="changelog-content" set:html={code} />
</StarlightPage>

<style>
	.changelog-content :global(h1:first-of-type) {
		display: none;
	}
</style>
